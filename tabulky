sig uživatel{}

sig hodnoty
{
	kalorie: one Int,
	bílkoviny: one Int,
	sacharidy: one Int,
	tuky: one Int
}

sig jídlo
{
	zápis: one uživatel,
	kcalHodnota: one hodnoty
}

fact prirozena_cisla
{
    all h : hodnoty | h.kalorie >= 0 and h.bílkoviny >= 0 
                       and h.sacharidy >= 0 and h.tuky >= 0
} //deklaruju podmínku která stanovuje že všechny fidy pro atomy z hodnoty(které pojmenujeme h) musejí mít kalorie(h.kalorie) musí být větší nebo se robnat (>=0)

fact součet_maker_je_roven_kaloriim
{
	all h : hodnoty | h.kalorie = h.bílkoviny.plus[h.sacharidy].plus[h.tuky]
} //řeší to že hodnota kalorii se musí rovnat součtu všech ostatních hodnot dohromady


fun celkoveKalorieProJednohoUživatele [u : uživatel] : Int //u z uživatel s návratovým typem Int
{
	(zápis.u.kcalHodnota.kalorie).sum
}

//-----Funkce přídání jídla-----

var sig zapsané in jídlo {} //měnitelná podmnožina jídel jménem "zapsané"

fact prvnotníStav //prostě jen dekraluju pravidlo
{
	no zapsané
}

pred přidáníJídla [j : jídlo] //jídlo se přidá
{
	j not in zapsané//pokud tam už není
	zapsané' = zapsané + j //přidá se do zapsane
}

pred žádnáZměna//nic se nezmění
{
	zapsané' = zapsané
}

fact přesun//tady se využije to přidáníJídla a žádnáZmě
{
	always
		(
			(
				some j : jídlo | přidáníJídla[j] or žádnáZměna
			)
		)
}
