run t3_cycle_of_logging_and_removing_foods
{
	eventually
	(
		one u : user |
		no u.logged and //start: user has no foods logged
		after eventually
		(
			#u.logged = 1 and //he will get logged one food
			after eventually
			(
				#u.logged = 2 and //then afterwards second food
				after eventually
				(
					#u.logged = 1 and //one logged food will get removed
					after eventually
					(
						no u.logged //then the second logged food will get removed
					)
				)
			)
		)
	)
} for exactly 1 user, exactly 2 food_in_database, exactly 2 value, 9 Int


