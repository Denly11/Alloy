//----Declarations----

sig user{
var totat_calories: one Int
}

sig value
{
	calories: one Int,
	protein: one Int,
	carbohydrates: one Int,
	fats: one Int
}

sig food_in_database
{
	log: one user,
	caloricValue: one value
}

fact natural_numbers
{
    all v : value | v.calories >= 0 and v.protein >= 0 
                       and v.carbohydrates >= 0 and v.fats >= 0
} //declaring that all fields of signature value mush have value equal or higher than 0


fact sum_of_all_macros_is_equal_to_calories
{
	all v : value  | v.calories = v.protein.plus[v.carbohydrates].plus[v.fats]
} //declaring that calories, field of signature value, must be equal to toral sum of values of all of the other fields of signature value


fun sum_of_all_calories_for_user [u : user] : Int //"u" from user with int type
{
	((log.u) & logged).caloricValue.calories.sum//intersection of all foods of one particular user and all foods that has been logged to any user
}

//-----Functions for manipulation with foods-----

var sig logged in food_in_database {} //variable subset of sygnature food_in_database, without this foods could not be added/removed in states(by always), but would stay the same

fact initial_state //initial state shere no food from database is logged
{
	no logged
}

pred log_food [f : food_in_database] //food will be addted to logged from database
{
	f not in logged//pokud tam už není
	logged' =logged + f //přidá se do zapsane
}

pred remove_food [l: logged]
{
	l in logged
	logged' = logged - l
}


pred no_change//nothing will change
{
	logged' = logged
}

fact state_transition//he is selected next step of what will happen
{
	always
		(
				some f : food_in_database | log_food[f] or remove_food[f] or no_change
		)
}

fact {
always//declares all one possible changes that can happen by transiton from one state to another
	(
  	  all u : user | u.totat_calories= sum_of_all_calories_for_user[u]
	)
}

