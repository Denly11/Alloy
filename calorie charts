//----Declarations----

sig user
{
	var totat_calories: one Int,
	var logged: set logged_food_in_database
}

sig value
{
	calories: one Int,
	protein: one Int,
	carbohydrates: one Int,
	fats: one Int
}

sig food_in_database
{
	caloricValue: one value
}

fact natural_numbers //declaring that all fields of signature value mush have value equal or higher than 0
{
	all v : value | v.calories >= 0 and
	v.protein >= 0 and
	v.carbohydrates >= 0
	and v.fats >= 0
} 

fact sum_of_all_macros_is_equal_to_calories //declaring that calories, field of signature value, must be equal to toral sum of values of all of the other fields of signature value
{
	all v : value  | v.calories = v.protein.plus[v.carbohydrates].plus[v.fats]
}

fun sum_of_all_calories_for_user [u : user] : Int //"u" from user with int type
{
	sum f : u.logged | f.caloricValue.calories
}

fact every_value_has_food//declaring that each value is asiggned to its food
{
	all v : value | some f : food_in_database | f.caloricValue = v
}


//-----Functions for manipulation with foods-----

var sig logged_food_in_database in food_in_database{} //variable subset of sygnature food_in_database, without this foods could not be added/removed in states(by always), but would stay the same

fact initial_state //initial state shere no food from database is logged
{
	no logged
	no logged_food_in_database
}

pred log_food [f : food_in_database, u : user]  //food will be addted to logged from database
{
	f not in logged_food_in_database //it f is not already in there
	logged_food_in_database' =logged_food_in_database + f //WILL be added to the logged_food_in_database
	logged' = logged + (u -> f)//"->" creates bond, that connects two atoms so it is easyer to manipulate and there is no need for more lines of code
}

pred remove_food [f : food_in_database, u : user]
{
	f in u.logged  
	logged_food_in_database' = logged_food_in_database - f
	logged' = logged - (u -> f)
}

pred no_change//nothing will change
{
	logged' = logged
	logged_food_in_database' =  logged_food_in_database
	//no logged_food_in_database
}

fact state_transition//he is selected next step of what will happen
{
    always
        (
            some f : food_in_database, u : user | log_food[f, u] or remove_food[f, u] or no_change
        )
}

fact
{
	always//declares each possible changes that can happen by transiton from one state to another
	(
		all u : user | u.totat_calories= sum_of_all_calories_for_user[u]
	)
}


